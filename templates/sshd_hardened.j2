UsePAM yes
SyslogFacility AUTH
LogLevel VERBOSE
LoginGraceTime 60
StrictModes yes

# Authentication
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
IgnoreRhosts yes
HostbasedAuthentication no
MaxAuthTries 3

# RSA keys remain permitted, signed with SHA-2. SHA-1 (ssh-rsa) is not offered.
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256

{% if ansible_facts['distribution_version'] is version('26.04', '>=') %}
# mlkem768x25519-sha256 requires OpenSSH 9.9+, which lands in Ubuntu 26.04
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
{% else %}
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
{% endif %}
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,umac-128-etm@openssh.com

# Session
X11Forwarding no
PrintMotd no
PrintLastLog yes
TCPKeepAlive no
AllowTcpForwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
Banner /etc/issue.net

Subsystem sftp /usr/lib/openssh/sftp-server
